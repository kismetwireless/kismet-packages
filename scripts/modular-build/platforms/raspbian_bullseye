#!/bin/bash

# Raspbian Bullseye (armhf cross build); same libraries as Debian Bullseye

. "${BUILD_SCRIPT_ROOT}/platforms/debian_bullseye"

# Raspbian targets ARMv6, so the build uses the Raspberry Pi cross toolchain
# installed in the docker image instead of the Debian armhf compiler.  The
# platform is loaded before building and packaging, so configure, strip, and
# objdump all use it.
export PATH="${PATH}:/opt/cross-pi-gcc-10.2.0-0/bin"
