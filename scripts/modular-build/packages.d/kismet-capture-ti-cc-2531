#!/bin/bash

PKG_NAME="kismet-capture-ti-cc-2531"
PKG_DESCRIPTION="Kismet TI CC2531 802.15.4 Zigbee sniffer capture helper"

PKG_REQUIRES=(KISMET_CAPTURE_BASE_DEPENDS KISMET_LIBUSB)
PKG_DEPENDS=(
    "${KISMET_CAPTURE_BASE_DEPENDS[@]}"
    "${KISMET_LIBUSB}"
    )

PKG_ACCESS="device"
PKG_PROGRAM="/usr/bin/kismet_cap_ti_cc_2531"
PKG_UDEV_RULE="99-kismet-ticc2531.rules"
PKG_LEGACY_UDEV_RULES="/etc/udev/rules.d/99-kismet-ticc2521.rules"

pkg_stage() {
    _KISMET_INSTALL_BIN capture_ti_cc_2531/kismet_cap_ti_cc_2531 /usr/bin/kismet_cap_ti_cc_2531 || return 1
}
