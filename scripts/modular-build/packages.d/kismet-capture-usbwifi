#!/bin/bash

PKG_NAME="kismet-capture-usbwifi"
PKG_DESCRIPTION="Kismet userspace USB Wi-Fi (MediaTek mt76, Realtek rtw88) capture helper"
PKG_CONFIGURE="--enable-usbwifi"

# zstd and xz for compressed firmware
PKG_REQUIRES=(KISMET_CAPTURE_BASE_DEPENDS KISMET_LIBUSB KISMET_LIBZSTD KISMET_LIBLZMA)
PKG_DEPENDS=(
    "${KISMET_CAPTURE_BASE_DEPENDS[@]}"
    "${KISMET_LIBUSB}"
    "${KISMET_LIBZSTD}"
    "${KISMET_LIBLZMA}"
    )

# Suid only: the MediaTek and Realtek ids are the stock ids of common Wi-Fi
# dongles, so a udev rule cannot safely target only the adapters used for
# capture.  Root also lets libusb detach the kernel driver from the adapter.
PKG_ACCESS="suid"
PKG_PROGRAM="/usr/bin/kismet_cap_usbwifi"

pkg_stage() {
    _KISMET_INSTALL_BIN capture_userspace_usb_wifi/kismet_cap_usbwifi /usr/bin/kismet_cap_usbwifi || return 1

    # Firmware from linux-firmware (mediatek/, rtw88/), with its licenses, which
    # the userspace drivers load from /usr/share/kismet/firmware first, then from
    # the system firmware directories
    _KISMET_INSTALL_TREE capture_userspace_usb_wifi/firmware /usr/share/kismet/firmware || return 1
}
