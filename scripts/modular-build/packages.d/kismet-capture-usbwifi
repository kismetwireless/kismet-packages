#!/bin/bash

PKG_NAME="kismet-capture-usbwifi"
PKG_DESCRIPTION="Kismet userspace USB Wi-Fi (MediaTek MT7921U) capture helper"
PKG_CONFIGURE="--enable-usbwifi"

PKG_REQUIRES=(KISMET_CAPTURE_BASE_DEPENDS KISMET_LIBUSB)
PKG_DEPENDS=(
    "${KISMET_CAPTURE_BASE_DEPENDS[@]}"
    "${KISMET_LIBUSB}"
    )

# Suid only: the MT7921U ids are the stock ids of common Wi-Fi dongles, so a
# udev rule cannot safely target only the adapters used for capture.  Root
# also lets libusb detach the kernel mt7921u driver from the adapter.
PKG_ACCESS="suid"
PKG_PROGRAM="/usr/bin/kismet_cap_usbwifi"

pkg_stage() {
    _KISMET_INSTALL_BIN capture_userspace_usb_wifi/kismet_cap_usbwifi /usr/bin/kismet_cap_usbwifi || return 1

    # Firmware from linux-firmware, with its license, which the userspace
    # drivers load from /usr/share/kismet/firmware instead of /lib/firmware
    _KISMET_INSTALL_TREE capture_userspace_usb_wifi/firmware /usr/share/kismet/firmware || return 1
}
