#!/bin/bash

PKG_NAME="kismet-capture-cell-diag"
PKG_DESCRIPTION="Kismet cell modem (Qualcomm DIAG) capture helper"

PKG_REQUIRES=(KISMET_CAPTURE_BASE_DEPENDS KISMET_LIBUSB)
PKG_DEPENDS=(
    "${KISMET_CAPTURE_BASE_DEPENDS[@]}"
    "${KISMET_LIBUSB}"
    )

PKG_ACCESS="device"
PKG_PROGRAM="/usr/bin/kismet_cap_cell_diag"
PKG_UDEV_RULE="99-kismet-cell-diag.rules"

pkg_stage() {
    _KISMET_INSTALL_BIN capture_cell_diag/kismet_cap_cell_diag /usr/bin/kismet_cap_cell_diag || return 1
}
