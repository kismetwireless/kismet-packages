#!/bin/bash

PKG_NAME="kismet-capture-rtladsb-v2"
PKG_DESCRIPTION="Kismet rtlsdr ADSB capture helper"

PKG_REQUIRES=(KISMET_CAPTURE_BASE_DEPENDS KISMET_LIBUSB KISMET_LIBRTLSDR)
PKG_DEPENDS=(
    "${KISMET_CAPTURE_BASE_DEPENDS[@]}"
    "${KISMET_LIBUSB}"
    "${KISMET_LIBRTLSDR}"
    )
PKG_CONFLICTS=("python3-kismetcapturertladsb")

PKG_ACCESS="device"
PKG_PROGRAM="/usr/bin/kismet_cap_sdr_rtladsb"
PKG_UDEV_RULE="99-kismet-sdr-rtladsb.rules"

pkg_stage() {
    _KISMET_INSTALL_BIN capture_sdr_rtladsb_v2/kismet_cap_sdr_rtladsb /usr/bin/kismet_cap_sdr_rtladsb || return 1
}
