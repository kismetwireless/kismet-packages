#!/bin/bash

PKG_NAME="kismet-capture-rtlaisadsb"
PKG_DESCRIPTION="Kismet rtlsdr combined AIS and ADS-B capture helper"

PKG_REQUIRES=(KISMET_CAPTURE_BASE_DEPENDS KISMET_LIBUSB KISMET_LIBRTLSDR)
PKG_DEPENDS=(
    "${KISMET_CAPTURE_BASE_DEPENDS[@]}"
    "${KISMET_LIBUSB}"
    "${KISMET_LIBRTLSDR}"
    )

PKG_ACCESS="device"
PKG_PROGRAM="/usr/bin/kismet_cap_sdr_rtlaisadsb"
PKG_UDEV_RULE="99-kismet-sdr-rtlaisadsb.rules"

pkg_stage() {
    _KISMET_INSTALL_BIN capture_sdr_rtlaisadsb/kismet_cap_sdr_rtlaisadsb /usr/bin/kismet_cap_sdr_rtlaisadsb || return 1
}
