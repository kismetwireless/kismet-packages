#!/bin/bash

PKG_NAME="kismet-capture-rtl433-v2"
PKG_DESCRIPTION="Kismet rtl_433 SDR capture helper"

PKG_REQUIRES=(KISMET_CAPTURE_BASE_DEPENDS KISMET_LIBUSB KISMET_LIBRTLSDR)
PKG_DEPENDS=(
    "${KISMET_CAPTURE_BASE_DEPENDS[@]}"
    "${KISMET_LIBUSB}"
    "${KISMET_LIBRTLSDR}"
    )
PKG_CONFLICTS=("python3-kismetcapturertl433")

PKG_ACCESS="device"
PKG_PROGRAM="/usr/bin/kismet_cap_sdr_rtl433"
PKG_UDEV_RULE="99-kismet-sdr-rtl433.rules"

pkg_stage() {
    _KISMET_INSTALL_BIN capture_sdr_rtl433_v2/kismet_cap_sdr_rtl433 /usr/bin/kismet_cap_sdr_rtl433 || return 1
}
