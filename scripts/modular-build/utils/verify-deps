#!/bin/bash

# Compare the shared libraries each staged binary links against with the
# dependencies the package declares.  Libraries are resolved to the debian
# packages which own them, from the sysroot dpkg database when cross
# compiling.

# Provided by libc and the compiler runtime; never declared explicitly
VERIFY_DEPS_IGNORE=(
    "libc6"
    "libstdc++6"
    "libgcc-s1"
    "libgcc1"
    )

if test "${BUILD_CROSS}" = "1"; then
    VERIFY_DEPS_ROOT="/sysroot"
    VERIFY_DEPS_DPKG=(dpkg --admindir=/sysroot/var/lib/dpkg)
    OBJDUMP="${OBJDUMP:-${ABI}-objdump}"
else
    VERIFY_DEPS_ROOT=""
    VERIFY_DEPS_DPKG=(dpkg)
    OBJDUMP="${OBJDUMP:-objdump}"
fi

# _VERIFY_DEPS_FIND_LIB [soname]
# Print the path of the library, relative to the root it was found in
_VERIFY_DEPS_FIND_LIB() {
    for d in /lib/${ABI} /usr/lib/${ABI} /lib /usr/lib; do
        if test -e "${VERIFY_DEPS_ROOT}${d}/$1"; then
            echo -n "${d}/$1"
            return 0
        fi
    done

    return 1
}

# _VERIFY_DEPS_OWNER [library path]
# Print the package owning the library; merged-/usr systems may register
# the file under either /lib or /usr/lib
_VERIFY_DEPS_OWNER() {
    for p in "$1" "${1#/usr}" "/usr$1"; do
        OWNER=$("${VERIFY_DEPS_DPKG[@]}" -S "${p}" 2> /dev/null | head -n 1 | cut -d: -f1)

        if test "${OWNER}"x != "x"; then
            echo -n "${OWNER}"
            return 0
        fi
    done

    return 1
}

# _VERIFY_DEPS [stage dir] [declared dependency ...]
_VERIFY_DEPS() {
    STAGE=$1
    shift

    # Strip version constraints from the declared dependencies
    DECLARED=" ${VERIFY_DEPS_IGNORE[*]} "
    for d in "$@"; do
        DECLARED="${DECLARED}${d%% *} "
    done

    FAILED=0

    while IFS= read -r -d '' f; do
        NEEDED=$(${OBJDUMP} -p "${f}" 2> /dev/null | awk '$1 == "NEEDED" { print $2 }')

        for so in ${NEEDED}; do
            LIB=$(_VERIFY_DEPS_FIND_LIB "${so}")

            if test "${LIB}"x = "x"; then
                echo "*** verify-deps: ${f#${STAGE}} needs ${so}, which could not be found ***"
                FAILED=1
                continue
            fi

            OWNER=$(_VERIFY_DEPS_OWNER "${LIB}")

            if test "${OWNER}"x = "x"; then
                echo "*** verify-deps: ${f#${STAGE}} needs ${LIB}, which no package owns ***"
                FAILED=1
                continue
            fi

            if [[ "${DECLARED}" != *" ${OWNER} "* ]]; then
                echo "*** verify-deps: ${f#${STAGE}} needs ${so} from ${OWNER}, which ${PKG_NAME} does not depend on ***"
                FAILED=1
            fi
        done
    done < <(find "${STAGE}" -type f -perm -u+x -print0)

    if test "${FAILED}" = 1 -a "${VERIFY_DEPS}" = "fail"; then
        return 1
    fi

    return 0
}
