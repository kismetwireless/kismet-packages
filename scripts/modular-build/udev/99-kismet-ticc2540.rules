# TI CC2540 BTLE sniffer
# Grants members of the kismet group access; enabled by the kismet-capture postinst
# when udev device access is selected.

SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0451", ATTR{idProduct}=="16b3", MODE="0660", GROUP="kismet"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0451", ATTR{idProduct}=="16b3", SYMLINK+="ticc2540-%k"
