if test "${BUILD_CAPTURE_LINUX_WIFI}" = "1"; then
    fpm -t deb -a ${ARCH} -s dir -n kismet-capture-linux-wifi -v ${PACKAGE} \
        --description "Kismet Linux Wi-Fi capture helper" \
        --deb-templates ${BUILD_SCRIPT_ROOT}/debian/kismet.templates \
        --deb-config ${BUILD_SCRIPT_ROOT}/debian/kismet.config \
        --post-install ${BUILD_SCRIPT_ROOT}/debian/kismet_cap_linux_wifi.postinst \
        ${LIBNL_DEPENDS} \
        ${LIBCAP_DEPENDS} \
        ${LIBPCAP_DEPENDS} \
        ${LIBNM_DEPENDS} \
        ${LIBWEBSOCKETS_DEPENDS} \
        /build/kismet/capture_linux_wifi/kismet_cap_linux_wifi=/usr/bin/kismet_cap_linux_wifi || { BUILD_FAILED=1; } &
fi
