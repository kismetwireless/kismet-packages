
if test "${BUILD_CAPTURE_RADIACODE_USB}" = "1"; then
    fpm -t deb -a ${ARCH} -s dir -n kismet-capture-radiacode-usb -v ${PACKAGE} \
        --description "Kismet Radiacode USB Geiger counter driver" \
        --deb-templates ${BUILD_SCRIPT_ROOT}/debian/kismet.templates \
        --deb-config ${BUILD_SCRIPT_ROOT}/debian/kismet.config \
        ${LIBCAP_DEPENDS} \
        ${LIBUSB_DEPENDS} \
        ${LIBWEBSOCKETS_DEPENDS} \
        /build/kismet/packaging/udev/99-kismet-radiacode-usb.rules=/etc/udev/rules.d/99-kismet-radiacode-usb.rules \
        /build/kismet/capture_radiacode/kismet_cap_radiacode_usb=/usr/bin/kismet_cap_radiacode_usb || { BUILD_FAILED=1; }&
fi

