
if test "${BUILD_CAPTURE_NRF_51822}" = "1"; then
    fpm -t deb -a ${ARCH} -s dir -n kismet-capture-nrf-51822 -v ${PACKAGE} \
        --description "Kismet NRF51822 BTLE Sniffer capture helper" \
        --deb-templates ${BUILD_SCRIPT_ROOT}/debian/kismet.templates \
        --deb-config ${BUILD_SCRIPT_ROOT}/debian/kismet.config \
        ${LIBCAP_DEPENDS} \
        ${LIBUSB_DEPENDS} \
        ${LIBWEBSOCKETS_DEPENDS} \
        /build/kismet/packaging/udev/99-kismet-nrf51822.rules=/etc/udev/rules.d/99-kismet-nrf51822.rules \
        /build/kismet/capture_nrf_51822/kismet_cap_nrf_51822=/usr/bin/kismet_cap_nrf_51822 || { BUILD_FAILED=1; } &
fi

